{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ProyectoColosio/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://TU-BACKEND.onrender.com/api/:path*" },
    { "source": "/trpc/:path*", "destination": "https://TU-BACKEND.onrender.com/trpc/:path*" },
    { "source": "/storage/:path*", "destination": "https://TU-BACKEND.onrender.com/storage/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
